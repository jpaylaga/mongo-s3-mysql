{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    "declaration": true,
    "customConditions": ["source"],
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "vitest.e2e.config.ts"]
}
